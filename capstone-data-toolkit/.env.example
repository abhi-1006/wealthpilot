# Copy to .env and fill in. Only the provider you actually use needs a key.

DATAGEN_PROVIDER=gemini

# Gemini AI Studio -- free tier, get a key at https://aistudio.google.com/apikey
DATAGEN_GEMINI_API_KEY=
DATAGEN_GEMINI_MODEL=gemini-2.0-flash

# OpenRouter -- backup when Gemini rate-limits
DATAGEN_OPENROUTER_API_KEY=
DATAGEN_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Ollama -- fully local, no key, no rate limit, slower
DATAGEN_OLLAMA_HOST=http://localhost:11434
DATAGEN_OLLAMA_MODEL=llama3.1:8b

# Reproducibility: teams sharing a seed get identical corpora
DATAGEN_SEED=42

# Corpus sizing
DATAGEN_CORPUS_DOCS=50
DATAGEN_INTAKE_RECORDS=200
DATAGEN_EVAL_ITEMS=20

DATAGEN_OUTPUT_DIR=./data
